+MODULOS_BLOCO_2 = ("bases", "etapa1", "etapa2", "etapa11", "conclusoes")   # conclusoes SEMPRE por último
+
+
+def _aplicar_modulos_bloco_2(saida, ctx):
+    """Chama `aplicar(saida, ctx)` de cada `gerar_prototipo_b2_<nome>.py`, na ordem de MODULOS_BLOCO_2.
+
+    O import mora aqui dentro (e só o main chama) para o gerar_pontos.py, que importa este arquivo
+    como biblioteca, não carregar nada novo. Três regras:
+    - módulo que NÃO existe no disco não quebra a rodada: vai para `bloco_2_ausencias` com o motivo,
+      e as conclusões que dependem dele saem fora da tela pelo próprio módulo de conclusões;
+    - erro DENTRO de um módulo existente quebra a rodada: as guardas dos módulos são de propósito
+      (conferem contra o que o gerador gravou), e gravar meio bloco seria pior que não gravar;
+    - o módulo tem de devolver exatamente os caminhos que declara em CAMPOS.
+    """
+    import importlib
+    import importlib.util
+    # Rodado como script, este arquivo é `__main__`; os módulos fazem `import gerar_prototipo as G` e
+    # carregariam uma SEGUNDA cópia (sem DECL, e o `ctx['G'] is G` do módulo de bases falharia).
+    este = sys.modules[__name__]
+    sys.modules.setdefault("gerar_prototipo", este)
+    ctx = dict(ctx, G=sys.modules["gerar_prototipo"])
+    ausencias = {}
+    for nome in MODULOS_BLOCO_2:
+        mod_nome = f"gerar_prototipo_b2_{nome}"
+        if importlib.util.find_spec(mod_nome) is None:
+            ausencias[nome] = dict(arquivo=f"{mod_nome}.py",
+                                   motivo="módulo não encontrado na raiz do projeto: os caminhos dele não foram gravados")
+            print(f"bloco 2: {mod_nome}.py AUSENTE — segue sem ele")
+            continue
+        mod = importlib.import_module(mod_nome)
+        feitos = mod.aplicar(saida, ctx)
+        if sorted(feitos) != sorted(mod.CAMPOS):
+            raise SystemExit(f"{mod_nome}: devolveu caminhos diferentes de CAMPOS: "
+                             f"{sorted(set(feitos) ^ set(mod.CAMPOS))}")
+        print(f"bloco 2: {mod_nome} gravou {len(feitos)} caminhos")
+    if ausencias:
+        saida["bloco_2_ausencias"] = ausencias
+
+
