{
  "manifest_version": 3,
  "name": "BFR Busca Jogador — Wyscout e SkillCorner",
  "version": "1.3.1",
  "description": "Deixa o app Santa Cruz (localhost:5090 e o site) buscar o jogador no Wyscout e no SkillCorner em que você está logado e trazer o técnico e o físico.",
  "key": "",
  "permissions": ["scripting", "tabs"],
  "host_permissions": [
    "https://wyscout.hudl.com/*",
    "https://searchapi.wyscout.com/*",
    "https://skillcorner.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*",
      "https://henriquesimoessilva3-png.github.io/*"
    ]
  }
}
